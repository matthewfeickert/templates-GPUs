log = build_apptainer_container_$(Process).log.txt

transfer_input_files = ./apptainer.def, ./pixi.toml, ./pixi.lock, ./.gitignore

+IsBuildJob = True

request_cpus = 2
# mksquashfs configures itself from the build host (one compression thread
# per host CPU core, caches sized at 25% of the host's physical memory)
# rather than from the job's resource limits, so the SIF creation step can
# crash on memory-limited slots. Pass '--mksquashfs-args' to apptainer
# build as documented in README.md to bound mksquashfs to the requested
# resources and to avoid a known mksquashfs segfault under proot on
# many-core hosts (worked around in Apptainer v1.5.2+).
# 8GB pairs with the '-mem 4G' in '--mksquashfs-args'; if building without
# it, request 16GB instead (~1.4x the ~10 GB uncompressed rootfs, the
# observed peak mksquashfs memory use when unconstrained).
request_memory = 8GB
# high disk use
request_disk = 32GB

queue
